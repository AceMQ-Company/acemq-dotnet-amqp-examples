<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AceMq.Examples</RootNamespace>
    <!--
      VB.NET defaults to Option Strict Off, which lets a mistyped call compile
      and fail at run time. An example is copied, so it should not teach that.
    -->
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AceMq.Amqp" Version="$(AceMqVersion)" />
    <PackageReference Include="AceMq.Amqp.RabbitMq" Version="$(AceMqVersion)" />
    <!--
      Avro is its own package. It brings Apache.Avro, and Newtonsoft.Json and
      System.CodeDom behind it, which is precisely why the core library does not
      depend on it.
    -->
    <PackageReference Include="AceMq.Amqp.Avro" Version="$(AceMqVersion)" />
  </ItemGroup>

</Project>
