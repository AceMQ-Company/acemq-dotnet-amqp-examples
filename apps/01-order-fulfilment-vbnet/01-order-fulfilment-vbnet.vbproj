<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AceMq.Examples</RootNamespace>
    <!--
      VB.NET defaults to Option Strict Off, which lets a mistyped call compile
      and fail at run time. An example is copied, so it should not teach that.
    -->
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AceMq.Amqp" Version="$(AceMqVersion)" />
    <PackageReference Include="AceMq.Amqp.RabbitMq" Version="$(AceMqVersion)" />
    <!--
      The gateway's orders and outbox, and payments' idempotency claims. Two
      databases, one per service, and each a file of its own; see FreshDatabase in Program.vb.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>
