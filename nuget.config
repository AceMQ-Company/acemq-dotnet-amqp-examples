<?xml version="1.0" encoding="utf-8"?>
<!--
  The examples resolve the released packages from the AceMQ feed, so they use
  exactly what the documentation tells you to depend on.

  The feed is a static directory tree served over HTTPS. It offers only the flat
  container, which is enough for restore and not enough for `dotnet package
  search` — see the note in the README.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="acemq" value="https://acemq.org/nuget/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
