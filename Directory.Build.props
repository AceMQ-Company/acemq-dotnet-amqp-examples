<Project>

  <!--
    Shared by every example, so each project file says only what makes that
    example different. The version is here rather than in a project file each
    because bumping it in thirty-four places is how one gets left behind.

    Every AceMQ package is versioned together on purpose, so one property covers
    AceMq.Amqp, AceMq.Amqp.RabbitMq, AceMq.Amqp.Crypto and AceMq.Amqp.Avro
    alike.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AceMqVersion>0.5.0</AceMqVersion>
    <!-- An example that warns is an example somebody copies warnings from. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      net8.0 is the target because it is the oldest still supported, so the
      examples reach the widest audience. RollForward lets them run on whatever
      runtime is actually installed — otherwise somebody with only .NET 10 gets
      "the framework Microsoft.NETCore.App 8.0.0 was not found" from an example
      that is perfectly fine.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

</Project>
